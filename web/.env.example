# Pick which provider powers the Explain + Chat panels.
#   claude-cli  → spawn `claude -p` headlessly (uses your existing Claude Code auth)
#   openai      → use the OpenAI SDK (requires OPENAI_API_KEY below)
#   none        → AI disabled; routes return the raw retrieved context
# If unset, defaults to "openai" when OPENAI_API_KEY is set, else "none".
LLM_PROVIDER=claude-cli

# Claude Code CLI options (only used when LLM_PROVIDER=claude-cli)
CLAUDE_MODEL=haiku

# OpenAI options (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
